diff --git a/tests/Feature/MailBrandingTest.php b/tests/Feature/MailBrandingTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/MailBrandingTest.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Mail\AuthenticationCode;
+use App\Mail\ContactMessage;
+use App\Notifications\UserNotice;
+use Illuminate\Mail\Markdown;
+use Tests\TestCase;
+
+class MailBrandingTest extends TestCase
+{
+    protected function setUp(): void
+    {
+        parent::setUp();
+        config(['pwa_store.frontend_url' => 'https://pwastore.online/']);
+    }
+
+    private function assertBrand(string $html): void
+    {
+        $this->assertStringContainsString('src="https://pwastore.online/brand/pwa-store-icon.png"', $html);
+        $this->assertStringContainsString('alt="PWA Store"', $html);
+        $this->assertStringContainsString('href="https://pwastore.online"', $html);
+        $this->assertStringNotContainsString('laravel.com/img', $html);
+    }
+
+    public function test_authentication_email_keeps_its_code_and_adds_the_store_icon(): void
+    {
+        $html = (new AuthenticationCode('123456', 'login'))->render();
+        $this->assertBrand($html);
+        $this->assertStringContainsString('123456', $html);
+    }
+
+    public function test_contact_email_keeps_escaping_user_content(): void
+    {
+        $html = (new ContactMessage(['name' => '<script>name</script>', 'email' => 'sender@example.com',
+            'subject' => 'Support', 'message' => '<img src="untrusted">']))->render();
+        $this->assertBrand($html);
+        $this->assertStringContainsString('&lt;script&gt;name&lt;/script&gt;', $html);
+        $this->assertStringNotContainsString('<img src="untrusted">', $html);
+    }
+
+    public function test_notifications_use_the_shared_store_icon(): void
+    {
+        $notice = new UserNotice('account.welcome', 'Bienvenue', 'Votre compte est prêt.', '/account');
+        $mail = $notice->toMail((object) ['name' => 'Alice']);
+        $html = (string) app(Markdown::class)->render($mail->markdown, $mail->data());
+        $this->assertBrand($html);
+        $this->assertStringContainsString('https://pwastore.online/account', $html);
+        $this->assertStringContainsString('Alice', $html);
+    }
+}
