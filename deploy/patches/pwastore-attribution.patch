+import { readFileSync } from 'node:fs'
+import vm from 'node:vm'
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+
+const controller = readFileSync(new URL('../app/Http/Controllers/Api/InstallSignalController.php', import.meta.url), 'utf8')
+const script = controller.split("<<<'JS'\n")[1].split('\nJS;')[0]
+const reference = 'a'.repeat(43)
+const storage = () => {
+  const data = new Map()
+  return { getItem: key => data.get(key) ?? null, setItem: (key, value) => data.set(key, value) }
+}
+function browser({ ref, standalone = false, local = storage(), session = storage(), key = 'app-one', fetchImpl } = {}) {
+  const calls = [], listeners = {}, replacements = []
+  const context = vm.createContext({
+    document: { currentScript: { getAttribute: () => key, src: 'https://api.pwastore.online/api/sdk.js' } },
+    localStorage: local, sessionStorage: session,
+    location: { href: 'https://app.example/start?keep=1' + (ref ? '&pwastore_ref=' + ref : '') + '#section' },
+    history: { state: { keep: true }, replaceState: (...args) => replacements.push(args) },
+    URL, navigator: {},
+    window: { crypto: { randomUUID: () => 'device-12345678' }, matchMedia: () => ({ matches: standalone }), addEventListener: (name, fn) => { listeners[name] = fn } },
+    crypto: { randomUUID: () => 'device-12345678' },
+    fetch: (...args) => { calls.push(JSON.parse(args[1].body)); return fetchImpl ? fetchImpl(...args) : Promise.resolve({ type: 'opaque' }) }
+  })
+  vm.runInContext(script, context)
+  return { calls, local, session, replacements, install: () => listeners.appinstalled?.() }
+}
+const flush = () => new Promise(resolve => setImmediate(resolve))
+
+test('direct browser and standalone visitors send nothing, even when installing', async () => {
+  for (const standalone of [false, true]) {
+    const b = browser({ standalone }); b.install(); await flush()
+    assert.equal(b.calls.length, 0)
+    assert.equal(b.local.getItem('pwastore-device'), null)
+  }
+})
+test('a Store click precedes immediate launch and installation signals', async () => {
+  let release
+  const pending = new Promise(resolve => { release = resolve })
+  const b = browser({ ref: reference, standalone: true, fetchImpl: () => pending })
+  b.install(); await flush()
+  assert.deepEqual(b.calls.map(c => c.event), ['open'])
+  release({ type: 'opaque' }); await flush()
+  assert.deepEqual(b.calls.map(c => c.event), ['open', 'launch', 'installed'])
+  assert.ok(b.calls.every(c => c.ref === reference))
+  assert.equal(b.replacements[0][2], '/start?keep=1#section')
+})
+test('attribution survives later launches and launch counts once per session', async () => {
+  const first = browser({ ref: reference }); await flush()
+  const second = browser({ local: first.local, standalone: true }); await flush()
+  assert.deepEqual(second.calls.map(c => c.event), ['launch'])
+  const reload = browser({ local: first.local, session: second.session, standalone: true }); await flush()
+  assert.equal(reload.calls.length, 0)
+  const next = browser({ local: first.local, standalone: true }); await flush()
+  assert.equal(next.calls.length, 1)
+})
+test('attribution and session markers cannot leak between apps sharing an origin', async () => {
+  const first = browser({ ref: reference, standalone: true }); await flush()
+  const other = browser({ local: first.local, session: first.session, key: 'app-two', standalone: true }); await flush()
+  assert.equal(other.calls.length, 0)
+  const click = browser({ local: first.local, session: first.session, key: 'app-two', standalone: true, ref: reference }); await flush()
+  assert.deepEqual(click.calls.map(c => c.event), ['open', 'launch'])
+})
+test('malformed references do not enable measurement', async () => {
+  const b = browser({ ref: 'forged', standalone: true }); b.install(); await flush()
+  assert.equal(b.calls.length, 0)
+})
+test('blocked storage does not break the host application', async () => {
+  const blocked = { getItem() { throw new Error('blocked') }, setItem() { throw new Error('blocked') } }
+  const b = browser({ ref: reference, standalone: true, local: blocked, session: blocked }); b.install(); await flush()
+  assert.equal(b.calls.length, 0)
+})
+test('network failure is caught and subsequent signals can redeem the reference', async () => {
+  let count = 0
+  const b = browser({ ref: reference, standalone: true, fetchImpl: () => ++count === 1 ? Promise.reject(new Error('offline')) : Promise.resolve({ type: 'opaque' }) })
+  await flush()
+  assert.deepEqual(b.calls.map(c => c.event), ['open', 'launch'])
+  assert.equal(b.calls[1].ref, reference)
+})
